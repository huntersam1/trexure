{
  "name": "trexure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch --conditions=react-server worker/index.ts",
    "worker:start": "node --conditions=react-server dist/worker/index.js",
    "worker:prod": "tsx --conditions=react-server worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release": "bash scripts/release.sh",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm audit --audit-level=high",
    "zk:demo": "node zk/scripts/zk-demo.mjs",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1076.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "next": "^16.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "snarkjs": "^0.7.6",
    "zod": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.16.0",
      "ioredis": "5.10.1",
      "underscore": ">=1.13.8"
    },
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.469.0",
    "playwright": "^1.61.1",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
