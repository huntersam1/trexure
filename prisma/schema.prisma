generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

// How a batch disbursement is paid out to its receiver (P1: schema only;
// wired in P4/P5). POOL_WALLET = withdraw straight to a wallet (on-chain is
// settlement); POOL_BANK = withdraw to custody then mock PDAX off-ramp → fiat.
enum PayoutMethod {
  POOL_WALLET
  POOL_BANK
}

enum PaymentStatus {
  DRAFT
  PENDING
  ONCHAIN_CONFIRMED
  RECONCILING
  SETTLED
  FAILED
}

enum LegType {
  ONCHAIN
  FIAT
}

enum LegStatus {
  PENDING
  RECEIVED
  CONFIRMED
  FAILED
}

// Employee onboarding / HR (#133). Foundation for salary advance (#134) and
// non-monetary → cash conversion (#135).
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PackageItemType {
  BASE_SALARY
  BONUS
  ALLOWANCE
  BENEFIT_NON_MONETARY
}

enum PayCadence {
  MONTHLY
  ANNUAL
  ONE_OFF
}

// Non-monetary → cash conversion (#135).
enum ConversionStatus {
  REQUESTED
  APPROVED
  DISBURSED
  REJECTED
}

// Salary advance / earned wage access (#134).
enum AdvanceStatus {
  REQUESTED
  APPROVED
  DISBURSED
  REPAID
  REJECTED
}

model Tenant {
  id             String         @id @default(cuid())
  name           String
  users          User[]
  payments       Payment[]
  paymentBatches PaymentBatch[]
  viewKey        ViewKey?
  apiKeys        ApiKey[]
  anchors        AnchorConfig[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model User {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  username       String         @unique
  passwordHash   String // argon2id; NEVER plaintext
  role           Role           @default(MEMBER)
  sessions       Session[]
  createdBatches PaymentBatch[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId])
}

// Receiver (freelancer) persona — a global identity, NOT tenant-scoped: a
// receiver can be paid by any tenant. Isolated from `User`/`Session` so the
// tenant app shell and the receiver claim interface never share a session.
// Auth logic (login/session helpers, layout) lands in P3; this is the model.
model Receiver {
  id            String            @id @default(cuid())
  email         String            @unique // login identity; matched to batch rows
  passwordHash  String // argon2id; NEVER plaintext
  sessions      ReceiverSession[]
  payments      Payment[]
  notifications Notification[]
  employees     Employee[] // an employee record (per tenant) may map to this receiver persona (#133)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ReceiverSession {
  id         String   @id @default(cuid())
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // store hash of session token, not the token
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([receiverId])
}

// Groups the child `Payment`s created by one batch-send (P2). Tenant-scoped
// (direct `tenantId`; reachable through forTenant() — see lib/db.ts).
model PaymentBatch {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  createdByUserId   String
  createdBy         User      @relation(fields: [createdByUserId], references: [id])
  count             Int
  totalSourceAmount Decimal   @db.Decimal(38, 8)
  payments          Payment[]
  createdAt         DateTime  @default(now())

  @@index([tenantId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique // store hash of session token, not the token
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model ViewKey {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  encryptedKey Bytes // AES-256-GCM, app/KMS-encrypted at rest
  nonce        Bytes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  intentId          String        @unique // reconciliation join key (in memo + fiat ref)
  status            PaymentStatus @default(DRAFT)
  sourceAsset       String
  sourceAmount      Decimal       @db.Decimal(38, 8)
  targetCurrency    String
  targetAmount      Decimal?      @db.Decimal(38, 8)
  corridorFrom      String
  corridorTo        String
  recipientRef      String // opaque; PII minimized
  shielded          Boolean       @default(true)
  encryptedPayload  Bytes? // ZK-shielded payload blob
  payloadNonce      Bytes?
  proofHash         String?
  // --- Batch pool payout (P1 schema; wired in P2/P4/P5). All optional so
  // existing fiat/reconcile payments are untouched. ---
  batchId           String?
  batch             PaymentBatch? @relation(fields: [batchId], references: [id])
  payoutMethod      PayoutMethod?
  poolCommitment    String? // public note commitment (deposit)
  poolNullifierHash String? // public nullifier hash (withdraw)
  receiverId        String?
  receiver          Receiver?     @relation(fields: [receiverId], references: [id])
  // Claimable note re-shown to the payer, encrypted under the tenant view key
  // (never a plaintext bearer note). Nonce paired per-record.
  encryptedNote     Bytes?
  noteNonce         Bytes?
  legs              PaymentLeg[]
  receipt           Receipt?
  notifications     Notification[]
  claimLink         ClaimLink?
  disclosureLink    DisclosureLink?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([batchId])
  @@index([receiverId])
}

// Emailed claim link (#81, follow-up to batch epic #80). For an OFF-platform
// receiver (email given but no Trexure account — so #82's in-app notification
// couldn't reach them), batch send emails a signed one-time link instead of the
// raw bearer note. The note is stored here **encrypted under a key derived from
// the raw link token** (which lives only in the email, never in the DB), so a DB
// read alone can't reveal it; it's decrypted only after the receiver
// authenticates and presents the token. One link per disbursement.
model ClaimLink {
  id            String    @id @default(cuid())
  paymentId     String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique // sha256(rawToken) — lookup key; the token itself is never stored
  encryptedNote Bytes // AES-256-GCM(note) under sha256("…v1:" + rawToken)
  noteNonce     Bytes
  email         String // where the link was sent
  sentAt        DateTime? // provider accepted the message
  providerRef   String? // email provider message id (mock or real)
  revealedAt    DateTime? // first successful authenticated reveal
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([paymentId])
}

// Verifiable disclosure link (#128, builds on R2 #101 / R4 #103). An ADMIN mints
// a tokenized, no-login share link for ONE settled payment; an outside auditor
// opens `/verify/<token>` and sees only that payment's attestation and can
// re-verify it on-chain. We persist only `sha256(rawToken)` (the raw token lives
// in the shared URL, never in the DB), plus expiry + revocation so access is
// bounded and auditable. One active link per payment (re-issue rotates the
// token, invalidating the old URL). Tenant-scoped via its own tenantId.
model DisclosureLink {
  id              String    @id @default(cuid())
  paymentId       String    @unique
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenantId        String
  tokenHash       String    @unique // sha256(rawToken) — lookup key; the token itself is never stored
  createdByUserId String
  expiresAt       DateTime
  revokedAt       DateTime? // set on explicit revoke; a revoked link renders the safe invalid state
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, createdAt])
}

// In-app claim notification (#82, follow-up to batch epic #80). When a batch
// row's email matches an existing global Receiver account, the sender surfaces
// the incoming disbursement in that receiver's inbox instead of relying on an
// out-of-band note. NOT tenant-scoped (mirrors Receiver/ReceiverSession — it
// belongs to the global receiver persona, and the payer may be any tenant), so
// it is reached via plain `prisma`, never `forTenant`. References the
// disbursement only — never the bearer note (which is never persisted).
model Notification {
  id         String    @id @default(cuid())
  receiverId String
  receiver   Receiver  @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  paymentId  String
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type       String    @default("CLAIM")
  readAt     DateTime? // null = unread
  claimedAt  DateTime? // set when the referenced payment is claimed (clears it)
  createdAt  DateTime  @default(now())

  // One notification per receiver per disbursement — makes send-time creation
  // idempotent on batch retry.
  @@unique([receiverId, paymentId])
  @@index([receiverId, readAt])
}

model PaymentLeg {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  legType     LegType
  status      LegStatus @default(PENDING)
  // onchain
  txHash      String?
  ledger      Int?
  contractId  String?
  // fiat
  provider    String?
  providerRef String?
  bankRef     String?
  amount      Decimal?  @db.Decimal(38, 8)
  currency    String?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([paymentId, legType]) // idempotency: one leg of each type
  @@index([txHash])
  @@index([providerRef])
}

model Receipt {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  json        Json // the Stripe-ified object (§6.4)
  pdfKey      String? // storage key if exported
  generatedAt DateTime @default(now())
}

model AnchorConfig {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  provider      String // "xendit"
  webhookSecret Bytes // encrypted at rest
  config        Json
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyHash    String    @unique // store hash only
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String // provider event id for idempotency
  verified    Boolean
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String // e.g. "viewkey.decrypt", "auth.login"
  target    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// --- Employee onboarding / HR (#133) -------------------------------------
// All tenant-scoped via a direct `tenantId` scalar (no Tenant relation, mirroring
// AuditLog) and registered in DIRECT_TENANT_MODELS (lib/db.ts) so forTenant()
// enforces isolation. Foundation the payroll batch path, salary advance (#134),
// and non-monetary conversion (#135) read from.

model EmployeeRole {
  id            String     @id @default(cuid())
  tenantId      String
  title         String
  seniorityBand String?
  employees     Employee[]
  createdAt     DateTime   @default(now())

  @@unique([tenantId, title])
  @@index([tenantId])
}

model Employee {
  id         String                @id @default(cuid())
  tenantId   String
  name       String
  email      String
  status     EmploymentStatus      @default(ACTIVE)
  startDate  DateTime
  roleId     String?
  role       EmployeeRole?         @relation(fields: [roleId], references: [id])
  receiverId String? // links to the claim/wallet/bank persona when one exists
  receiver   Receiver?             @relation(fields: [receiverId], references: [id])
  packages   CompensationPackage[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
}

// Effective-dated compensation package. A new version supersedes the prior one
// (sets `supersededAt`) but the prior row is retained, so raises are auditable.
// The "current" package is the one with `supersededAt = null`.
model CompensationPackage {
  id              String        @id @default(cuid())
  tenantId        String
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime
  supersededAt    DateTime?
  createdByUserId String?
  items           PackageItem[]
  createdAt       DateTime      @default(now())

  @@index([tenantId])
  @@index([employeeId, effectiveFrom])
}

model PackageItem {
  id            String              @id @default(cuid())
  tenantId      String
  packageId     String
  package       CompensationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  type          PackageItemType
  label         String // description; for non-monetary, the described unit/benefit
  amount        Decimal?            @db.Decimal(38, 8) // monetary items
  currency      String? // monetary items
  notionalValue Decimal?            @db.Decimal(38, 8) // non-monetary notional cash value
  cadence       PayCadence          @default(MONTHLY)
  convertible   Boolean             @default(false) // feeds non-monetary → cash conversion (#135)
  // Cumulative notional value already converted to cash (#135). Remaining
  // convertible balance = notionalValue - convertedValue.
  convertedValue Decimal            @default(0) @db.Decimal(38, 8)
  conversions   PackageConversion[]
  createdAt     DateTime            @default(now())

  @@index([tenantId])
  @@index([packageId])
}

// --- Non-monetary → cash conversion (#135) --------------------------------
// Liquidates the convertible portion of a compensation package item into a
// cash payout via the existing pool payout rail. Tenant-scoped (direct
// `tenantId`, registered in DIRECT_TENANT_MODELS).

// Employer conversion policy (one per tenant). `ratePercent` is the fraction of
// notional paid out (a haircut < 100 keeps some value back); `feePercent` is
// deducted from the gross cash value.
model ConversionPolicy {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  ratePercent    Decimal  @default(100) @db.Decimal(5, 2)
  feePercent     Decimal  @default(0) @db.Decimal(5, 2)
  perConversionCap Decimal? @db.Decimal(38, 8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PackageConversion {
  id              String           @id @default(cuid())
  tenantId        String
  employeeId      String
  packageItemId   String
  packageItem     PackageItem      @relation(fields: [packageItemId], references: [id], onDelete: Cascade)
  notionalAmount  Decimal          @db.Decimal(38, 8) // notional value converted
  cashValue       Decimal          @db.Decimal(38, 8) // computed gross cash (notional × rate)
  fee             Decimal          @db.Decimal(38, 8) // deducted from cashValue
  currency        String           @default("XLM")
  status          ConversionStatus @default(REQUESTED)
  paymentId       String? // linked disbursement Payment once paid out
  createdByUserId String?
  approvedAt      DateTime?
  disbursedAt     DateTime?
  createdAt       DateTime         @default(now())

  @@index([tenantId])
  @@index([employeeId, status])
  @@index([packageItemId])
}

// --- Salary advance / earned wage access (#134) ---------------------------
// Employees draw against earned-but-unpaid salary; the advance (+fee) is netted
// out of a later salary payout and marked repaid. Tenant-scoped (direct
// `tenantId`, registered in DIRECT_TENANT_MODELS).

// Employer advance policy (one per tenant).
model AdvancePolicy {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  maxPercentAccrued Decimal  @default(50) @db.Decimal(5, 2) // max % of accrued salary advanceable
  perCycleCap       Decimal? @db.Decimal(38, 8) // absolute cap per pay cycle
  feePercent        Decimal  @default(0) @db.Decimal(5, 2) // flat fee on the advanced principal
  autoApproveUnder  Decimal? @db.Decimal(38, 8) // auto-approve requests at or below this amount
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SalaryAdvance {
  id                String        @id @default(cuid())
  tenantId          String
  employeeId        String
  amount            Decimal       @db.Decimal(38, 8) // principal advanced
  fee               Decimal       @db.Decimal(38, 8) // fee on the principal
  outstanding       Decimal       @db.Decimal(38, 8) // (amount + fee) − repaid; 0 when REPAID
  currency          String        @default("XLM")
  status            AdvanceStatus @default(REQUESTED)
  paymentId         String? // disbursement Payment (advance paid out)
  repaidByPaymentId String? // the salary Payment that netted the final repayment
  createdByUserId   String?
  approvedAt        DateTime?
  disbursedAt       DateTime?
  repaidAt          DateTime?
  createdAt         DateTime      @default(now())

  @@index([tenantId])
  @@index([employeeId, status])
}
